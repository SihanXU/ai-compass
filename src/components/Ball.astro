---
// An ideology drawn as a ball in its chart colour, with two eyes, as on ideology wikis.
// Ring titles get a halo, the centre gets a level gaze.
import { colourOf } from '../lib/data.js';
const { ide, size = 64, title = '' } = Astro.props;
const bg = colourOf(ide).bg;
const ring = !!ide.place.ring;
// eyes look a little toward where the ideology sits: left/right by column, up/down by row
const g = ide.place.center ? { c: 6, r: 5.5 } : ide.place.ring ? { c: 6, r: 5.5 } : { c: ide.place.col, r: ide.place.row };
const dx = ((g.c - 6) / 6) * 3;
const dy = ((g.r - 5.5) / 5.5) * 2;
const uid = `b${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="ball" width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={title || ide.name.en}>
    <defs>
        <clipPath id={uid}><circle cx="50" cy="52" r="44" /></clipPath>
        <radialGradient id={`${uid}g`} cx="35%" cy="30%" r="75%">
            <stop offset="0" stop-color="#fff" stop-opacity="0.35" />
            <stop offset="0.6" stop-color="#fff" stop-opacity="0" />
            <stop offset="1" stop-color="#000" stop-opacity="0.18" />
        </radialGradient>
    </defs>
    {ring && <circle cx="50" cy="52" r="48" fill="none" stroke="#e08a1e" stroke-width="3" stroke-dasharray="6 5" />}
    <circle cx="50" cy="52" r="44" fill={bg} />
    <g clip-path={`url(#${uid})`}><rect x="0" y="0" width="100" height="100" fill={`url(#${uid}g)`} /></g>
    <circle cx="50" cy="52" r="44" fill="none" stroke="#111" stroke-width="3.5" />
    <ellipse cx={36 + dx} cy={46 + dy} rx="8.5" ry="10" fill="#fff" stroke="#111" stroke-width="2.5" />
    <ellipse cx={64 + dx} cy={46 + dy} rx="8.5" ry="10" fill="#fff" stroke="#111" stroke-width="2.5" />
</svg>
