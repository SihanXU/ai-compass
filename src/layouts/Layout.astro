---
// Every page: sihanxu.me's top bar ("Sihan Xu / AI Compass"), the page, the footer.
import '../styles/site.css';
import { t, url, other, REPO } from '../lib/i18n.js';
import { tests } from '../lib/data.js';

const { lang, title, description, path = '', active = '', bare = false, footer = true } = Astro.props;
const fullTitle = title ? `${title} · ${t(lang, 'site')}` : t(lang, 'site');
const desc = description || t(lang, 'homeDek');
const nav = [
  ['chart', 'chart', 'navChart'],
  ['test', 'test/full', 'navTest'],
  ['wiki', 'wiki', 'navWiki'],
  ['method', 'method', 'navMethod'],
];
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={desc}>
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={desc}>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='44' fill='%232563eb' stroke='%23111' stroke-width='6'/%3E%3Cellipse cx='36' cy='44' rx='9' ry='11' fill='white' stroke='%23111' stroke-width='4'/%3E%3Cellipse cx='64' cy='44' rx='9' ry='11' fill='white' stroke='%23111' stroke-width='4'/%3E%3C/svg%3E">
    <link rel="alternate" hreflang={other(lang)} href={url(other(lang), path)}>
</head>
<body>
    {!bare && (
    <nav class="banner">
        <div class="container">
            <div class="brand">
                <a class="me" href="https://sihanxu.me/">Sihan Xu</a>
                <span class="sep">/</span>
                <a class="proj" href={url(lang)}>{t(lang, 'brand')}</a>
            </div>
            <div class="nav-links">
                {nav.map(([k, p, s]) => (
                    <a href={url(lang, p)} class:list={[{ active: active === k }, { 'hide-sm': k === 'method' || k === 'chart' }]}>{t(lang, s)}</a>
                ))}
                <a class="gh hide-sm" href={REPO} aria-label="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a>
                <a href={url(other(lang), path)} lang={other(lang)}>{t(lang, 'otherLang')}</a>
            </div>
        </div>
    </nav>
    )}
    <slot />
    {!bare && footer && (
    <footer class="footer">
        <div class="container">
            <span>{t(lang, 'footerLeft', { v: tests.version })} · <a href="https://sihanxu.me/">Sihan Xu</a></span>
            <span><a href={`${REPO}/blob/main/LICENSE`}>{t(lang, 'footerLicense')}</a> · <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>{t(lang, 'navContribute')}</a> · <a href={REPO}>GitHub</a></span>
        </div>
    </footer>
    )}
</body>
</html>
