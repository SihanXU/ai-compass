---
// The result: your match on a card, one two-coloured bar per axis with its label, your neighbours and titles, the chart.
import Layout from '../../layouts/Layout.astro';
import Chart from '../../components/Chart.astro';
import Legend from '../../components/Legend.astro';
import { clientData } from '../../lib/data.js';
import { t, url, pack, LANGS } from '../../lib/i18n.js';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const strings = pack(lang, [
  'closest', 'campIs', 'onChart', 'near', 'titles', 'noTitles', 'readEntry', 'retake', 'tryFull', 'share', 'copied',
  'saveImage', 'quickNote', 'noResult', 'paradigm', 'site', 'axes', 'axisCategory', 'catStrongNeg', 'catNeg', 'catMid', 'catPos', 'catStrongPos',
  'yourCamp', 'yourIdeology', 'tryPro', 'shareBtn', 'sharePortrait', 'shareLandscape', 'shareSave', 'shareCopyImage', 'shareCopyLink', 'shareNative', 'shareCopied', 'shareScan', 'shareText', 'shareClose', 'shareOn', 'shareCardResult', 'brand', 'consistencyLabel', 'subTitle', 'consistencyLabel', 'consistencyLow', 'consistencyHigh',
]);
const data = { ...clientData(lang), strings, wiki: url(lang, 'wiki/'), test: url(lang, 'test/'), shareBase: url(lang, 'share/'), home: url(lang) };
---
<Layout lang={lang} title={t(lang, 'resultLabel')} path="result" active="test">
    <main class="result-page">
        <div class="container">
            <section class="match">
                <div data-r-ball></div>
                <div>
                    <p class="label" data-r-label>{t(lang, 'closest')}</p>
                    <h1 data-r-name>…</h1>
                    <p class="motto" data-r-motto></p>
                    <div class="certainty" data-r-cert hidden></div>
                    <div class="actions" data-r-actions></div>
                </div>
            </section>
            <section class="axes-card" data-r-axes-card>
                <h2>{t(lang, 'axes')}</h2>
                <div data-r-axes></div>
            </section>
            <section class="axes-card" data-r-subs-card hidden>
                <h2>{t(lang, 'subTitle')}</h2>
                <div data-r-subs></div>
            </section>
            <section class="near-card" data-r-near-card>
                <div><h2>{t(lang, 'near')}</h2><ul class="near-list" data-r-near></ul></div>
                <div data-r-titles-box><h2>{t(lang, 'titles')}</h2><ul class="near-list" data-r-titles></ul><p class="muted" data-r-note hidden style="margin-top:0.75rem;font-size:0.92rem"></p></div>
            </section>
        </div>
        <section class="result-chart">
            <div class="container wide">
                <h2>{t(lang, 'resultChart')}</h2>
                <Chart lang={lang} />
                <Legend lang={lang} />
            </div>
        </section>
    </main>
    <dialog class="share" data-share>
        <div class="share-head">
            <h2>{t(lang, 'shareBtn')}</h2>
            <button type="button" class="ghost" data-share-close aria-label={t(lang, 'shareClose')}>✕</button>
        </div>
        <div class="share-body">
            <div class="share-preview">
                <div class="seg">
                    <button type="button" class="on" data-format="portrait">{t(lang, 'sharePortrait')}</button>
                    <button type="button" data-format="landscape">{t(lang, 'shareLandscape')}</button>
                </div>
                <img data-share-img alt="" />
            </div>
            <div class="share-side">
                <div class="share-actions">
                    <button type="button" class="btn primary" data-act="save">{t(lang, 'shareSave')}</button>
                    <button type="button" class="btn" data-act="copy-image">{t(lang, 'shareCopyImage')}</button>
                    <button type="button" class="btn" data-act="copy-link">{t(lang, 'shareCopyLink')}</button>
                    <button type="button" class="btn" data-act="native" hidden>{t(lang, 'shareNative')}</button>
                </div>
                <input class="share-link" data-share-link readonly />
                <div class="share-qr"><canvas data-share-qr width="220" height="220"></canvas><span>{t(lang, 'shareScan')}</span></div>
                <p class="label">{t(lang, 'shareOn')}</p>
                <div class="chips" data-share-sites></div>
            </div>
        </div>
    </dialog>
    <script type="application/json" id="compass-data" set:html={JSON.stringify(data)} />
</Layout>

<script>
  import { toChart, decodeResult, rank, headline, earned, campOf, ideologyColour, gridOf, COLS, ROWS, CENTER } from '../../lib/compass.js';
  import { ballSvg } from '../../lib/ball.js';
  import { drawShareCard } from '../../lib/sharecard.js';
  import qrcode from 'qrcode-generator';

  const D = JSON.parse(document.getElementById('compass-data').textContent);
  const S = D.strings;
  const L = D.lang;
  const $ = (sel) => document.querySelector(sel);
  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };

  // (the page is drawn at the end of this script, once everything below is defined)
  const COLS_AX = { x: ['#d9534f', '#3b7dd8'], y: ['#2f9e5b', '#8e5bd6'], p: ['#5a5f66', '#16a3b8'], o: ['#7d8794', '#e0a020'], a: ['#3f8f8f', '#e8642c'] };
  function category(v, ax) {
    const pole = v < 0 ? ax.neg[L] : ax.pos[L];
    const k = v < -0.6 ? 'catStrongNeg' : v < -0.2 ? 'catNeg' : v <= 0.2 ? 'catMid' : v <= 0.6 ? 'catPos' : 'catStrongPos';
    return S[k].replace('{pole}', pole);
  }

  function listItem(ide, sub) {
    const li = el('li');
    const a = el('a'); a.href = D.wiki + ide.id + '/';
    a.insertAdjacentHTML('beforeend', ballSvg(ideologyColour(ide).bg, 34, !!ide.place.ring));
    const tx = el('span'); tx.append(el('span', 't', ide.name[L]), el('span', 'm', sub ?? ide.motto[L]));
    a.append(tx); li.append(a);
    return li;
  }

  function show({ mode, s, subs, c }) {
    const quick = mode === 'quick';
    const best = headline(D.ideologies, s, quick)[0].ide;
    // neighbours: everything nearby, topic ideologies included, other than the headline
    const ranked = [{ ide: best }, ...rank(D.ideologies, s, quick).filter((e) => e.ide.id !== best.id)];
    const titles = quick ? [] : earned(D.ideologies, s);
    const bestCol = ideologyColour(best);

    let name, motto;
    if (quick) {
      const c = campOf(s);
      const camp = D.camps.find((x) => x.col === c.col && x.row === c.row);
      $('[data-r-label]').textContent = S.campIs;
      name = camp.name[L]; motto = camp.text[L];
    } else {
      name = best.name[L]; motto = best.motto[L];
    }
    $('[data-r-ball]').innerHTML = ballSvg(bestCol.bg, 170);
    const h1 = $('[data-r-name]'); h1.textContent = name;
    $('[data-r-motto]').textContent = quick ? motto : `“${motto}”`;
    document.title = `${name} · ${S.site}`;

    const acts = $('[data-r-actions]');
    const go = (text, href, primary) => { const a = el('a', 'btn' + (primary ? ' primary' : ''), text); a.href = href; acts.append(a); };
    go(S.readEntry, D.wiki + best.id + '/', true);
    if (quick) go(S.tryFull, D.test + 'full/');
    if (mode === 'full') go(S.tryPro, D.test + 'pro/');
    go(S.retake, D.test + mode + '/');
    const shareBtn = el('button', 'btn', S.shareBtn); shareBtn.type = 'button';
    shareBtn.addEventListener('click', () => openShare({ s, c, quick, name, motto, best, bestCol }));
    acts.append(shareBtn);

    // one bar per axis: the left pole's share on the left in its colour, the right pole's on the right
    const box = $('[data-r-axes]');
    (quick ? D.axes.slice(0, 2) : D.axes).forEach((ax) => {
      const v = s[ax.key];
      const right = Math.round(((v + 1) / 2) * 1000) / 10;
      const left = Math.round((100 - right) * 10) / 10;
      const wrap = el('div', 'vbar');
      const head = el('div', 'vbar-head');
      head.innerHTML = S.axisCategory.replace('{axis}', `<span>${ax.title[L]}</span>`).replace('{cat}', `<b>${category(v, ax)}</b>`);
      const row = el('div', 'vbar-row');
      const track = el('div', 'vbar-track');
      const l = el('span', 'l', left >= 9 ? `${left}%` : ''); l.style.cssText = `width:${left}%;background:${COLS_AX[ax.key][0]}`;
      const r = el('span', 'r', right >= 9 ? `${right}%` : ''); r.style.cssText = `width:${right}%;background:${COLS_AX[ax.key][1]}`;
      track.append(l, r);
      row.append(el('span', 'pole', ax.neg[L]), track, el('span', 'pole r', ax.pos[L]));
      wrap.append(head, row);
      box.append(wrap);
    });

    // pro: every sub-dimension as a small bar, grouped by axis; and how consistent the answers were
    if (subs) {
      const box2 = $('[data-r-subs]');
      D.axes.forEach((ax) => {
        const list = (D.subaxes[ax.key] || []).filter((sa) => subs[`${ax.key}.${sa.key}`] != null);
        if (!list.length) return;
        const g = el('div', 'sub-group');
        g.append(el('h3', null, ax.title[L]));
        list.forEach((sa) => {
          const v = subs[`${ax.key}.${sa.key}`];
          const right = Math.round(((v + 1) / 2) * 1000) / 10;
          const left = Math.round((100 - right) * 10) / 10;
          const wrap = el('div', 'vbar small');
          const head = el('div', 'vbar-head');
          head.innerHTML = `<b>${sa.name[L]}</b> · ${category(v, ax)}`;
          head.title = sa.text[L];
          const row = el('div', 'vbar-row');
          const track = el('div', 'vbar-track');
          const l = el('span', 'l', left >= 12 ? `${left}%` : ''); l.style.cssText = `width:${left}%;background:${COLS_AX[ax.key][0]}`;
          const r = el('span', 'r', right >= 12 ? `${right}%` : ''); r.style.cssText = `width:${right}%;background:${COLS_AX[ax.key][1]}`;
          track.append(l, r);
          row.append(el('span', 'pole', ax.neg[L]), track, el('span', 'pole r', ax.pos[L]));
          wrap.append(head, row);
          g.append(wrap);
        });
        box2.append(g);
      });
      $('[data-r-subs-card]').hidden = false;
    }
    if (c != null) {
      const cert = $('[data-r-cert]');
      const pct = Math.round(c * 100);
      cert.innerHTML = `<span class="meter"><i style="width:${pct}%"></i></span><span><b>${S.consistencyLabel} ${pct}%</b> · ${c < 0.4 ? S.consistencyLow : S.consistencyHigh}</span>`;
      cert.hidden = false;
    }

    const near = $('[data-r-near]');
    ranked.slice(quick ? 0 : 1, 5).forEach(({ ide }) => near.append(listItem(ide)));
    if (quick) {
      $('[data-r-titles-box] h2').textContent = S.onChart;
      $('[data-r-titles]').append(listItem(best));
      const note = $('[data-r-note]'); note.textContent = S.quickNote; note.hidden = false;
    } else {
      const tl = $('[data-r-titles]');
      if (!titles.length) tl.append(el('li', 'muted', S.noTitles));
      titles.forEach((ide) => tl.append(listItem(ide)));
    }

    const chart = document.querySelector('.chart');
    chart.querySelectorAll('.cell').forEach((c) => c.classList.add('dim'));
    const mark = (id, cls) => { const c = chart.querySelector(`.cell[data-id="${id}"]`); if (c) { c.classList.remove('dim'); c.classList.add(cls); } };
    mark(best.id, 'hit');
    ranked.slice(1, 5).forEach((e) => mark(e.ide.id, 'near-hit'));
    titles.forEach((ide) => mark(ide.id, 'near-hit'));
    const marks = chart.querySelector('.marks');
    if (quick) {
      const c = campOf(s);
      [1 / 3, 2 / 3].forEach((f) => {
        const v = el('div', 'third v'); v.style.left = `${f * 100}%`; marks.append(v);
        const h = el('div', 'third h'); h.style.top = `${f * 100}%`; marks.append(h);
      });
      const camp = el('div', 'camp'); camp.style.cssText = `left:${(c.col / 3) * 100}%;top:${(c.row / 3) * 100}%;width:33.34%;height:33.34%`;
      marks.append(camp);
    }
    // the pin sits on the cell you matched (the quick test, which has no cell match, pins your raw position)
    const at = quick ? { x: s.x, y: s.y } : (() => { const g = gridOf(best.place); return g.kind === 'center' ? { x: 0, y: 0 } : { x: -1 + (g.c + 0.5) * (2 / COLS), y: 1 - (g.r + 0.5) * (2 / ROWS) }; })();
    const pin = el('div', 'pin'); pin.style.left = `${((at.x + 1) / 2) * 100}%`; pin.style.top = `${((1 - at.y) / 2) * 100}%`;
    marks.append(pin);
  }

  // ---------------------------------------------------------------- sharing
  const dlg = document.querySelector('[data-share]');
  let current = null, format = 'portrait', cardBlob = null;
  const shareUrl = (best) => `${location.origin}${D.shareBase}${best.id}/${location.search}`;
  const siteUrl = () => `${location.host}${D.home.replace(/(en|zh)\/$/, '')}`;

  function render() {
    const { s, c, quick, name, motto, best, bestCol } = current;
    const axes = quick ? D.axes.slice(0, 2) : D.axes;
    const cv = drawShareCard({
      format, lang: L, label: `${S.site} · ${quick ? S.campIs : S.closest}`, name, motto, colour: bestCol.bg,
      bars: axes.map((ax) => ({ neg: ax.neg[L], pos: ax.pos[L], label: category(s[ax.key], ax), value: s[ax.key], colors: COLS_AX[ax.key] })),
      note: c != null ? `${S.consistencyLabel} ${Math.round(c * 100)}%` : '',
      ideologies: D.ideologies, highlight: best.id, url: current.url, site: S.site, siteUrl: siteUrl(), scan: S.shareScan,
    });
    dlg.querySelector('[data-share-img]').src = cv.toDataURL('image/png');
    cardBlob = null;
    cv.toBlob((b) => { cardBlob = b; });
  }

  function openShare(info) {
    current = { ...info, url: shareUrl(info.best) };
    dlg.querySelector('[data-share-link]').value = current.url;
    // a large QR code, for scanning in person
    const q = qrcode(0, 'M'); q.addData(current.url); q.make();
    const n = q.getModuleCount(), cv = dlg.querySelector('[data-share-qr]'), g = cv.getContext('2d'), m = cv.width / (n + 4);
    g.fillStyle = '#fff'; g.fillRect(0, 0, cv.width, cv.height); g.fillStyle = '#111';
    for (let r = 0; r < n; r++) for (let k = 0; k < n; k++) if (q.isDark(r, k)) g.fillRect(Math.floor((k + 2) * m), Math.floor((r + 2) * m), Math.ceil(m), Math.ceil(m));
    // posting to other sites
    const text = S.shareText.replace('{name}', info.name);
    const u = encodeURIComponent(current.url), tx = encodeURIComponent(text);
    const sites = [
      ['X', `https://x.com/intent/post?text=${tx}&url=${u}`],
      [L === 'zh' ? '微博' : 'Weibo', `https://service.weibo.com/share/share.php?url=${u}&title=${tx}`],
      ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${u}`],
      ['Telegram', `https://t.me/share/url?url=${u}&text=${tx}`],
    ];
    const box = dlg.querySelector('[data-share-sites]'); box.innerHTML = '';
    sites.forEach(([label, href]) => { const a = el('a', 'chip', label); a.href = href; a.target = '_blank'; a.rel = 'noopener'; box.append(a); });
    dlg.querySelector('[data-act="native"]').hidden = !navigator.share;
    render();
    dlg.showModal();
  }

  const flash = (btn) => { const t0 = btn.textContent; btn.textContent = S.shareCopied; setTimeout(() => { btn.textContent = t0; }, 1500); };
  const fileName = () => `ai-compass-${current.best.id}-${format}.png`;
  const withBlob = (fn) => (cardBlob ? fn(cardBlob) : setTimeout(() => withBlob(fn), 50));
  dlg.querySelectorAll('[data-format]').forEach((b) => b.addEventListener('click', () => {
    format = b.dataset.format;
    dlg.querySelectorAll('[data-format]').forEach((x) => x.classList.toggle('on', x === b));
    render();
  }));
  dlg.querySelector('[data-share-close]').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelector('[data-act="save"]').addEventListener('click', () => withBlob((blob) => {
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = fileName(); a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  }));
  dlg.querySelector('[data-act="copy-image"]').addEventListener('click', (e) => withBlob(async (blob) => {
    try { await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]); flash(e.target); } catch { e.target.disabled = true; }
  }));
  dlg.querySelector('[data-act="copy-link"]').addEventListener('click', (e) => {
    const input = dlg.querySelector('[data-share-link]');
    if (navigator.clipboard) navigator.clipboard.writeText(current.url).then(() => flash(e.target), () => input.select());
    else input.select();
  });
  dlg.querySelector('[data-act="native"]').addEventListener('click', () => withBlob(async (blob) => {
    const text = S.shareText.replace('{name}', current.name);
    const file = new File([blob], fileName(), { type: 'image/png' });
    const payload = navigator.canShare && navigator.canShare({ files: [file] }) ? { files: [file], text, url: current.url } : { text, url: current.url };
    try { await navigator.share(payload); } catch { /* cancelled */ }
  }));

  // draw the page
  const res = decodeResult(location.search);
  if (!res) {
    $('[data-r-name]').textContent = S.noResult;
    ['[data-r-axes-card]', '[data-r-near-card]'].forEach((s) => ($(s).hidden = true));
    const a = el('a', 'btn primary', S.retake); a.href = D.test + 'full/'; $('[data-r-actions]').append(a);
  } else {
    // place the stored (raw) scores on the chart the same way the ideologies were placed
    const k = D.calibration?.scale || {};
    const subs = res.subs && Object.fromEntries(Object.entries(res.subs).map(([key, v]) => [key, Math.max(-1, Math.min(1, v * (k[key.split('.')[0]] || 1)))]));
    show({ ...res, s: toChart(res.s, D.calibration), subs });
  }
</script>
