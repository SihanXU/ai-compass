---
// The test: one statement at a time on a card, five coloured answers, keys 1–5, progress kept in the tab.
import Layout from '../../../layouts/Layout.astro';
import { clientData, tests } from '../../../lib/data.js';
import { t, url, pack, LANGS } from '../../../lib/i18n.js';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ['quick', 'full'].map((mode) => ({ params: { lang, mode } })));
}
const { lang, mode } = Astro.params;
const n = tests[mode].questions.length;
const data = { ...clientData(lang), strings: pack(lang, ['count', 'a2', 'a1', 'a0', 'am1', 'am2']) };
const title = t(lang, mode === 'quick' ? 'quickTitle' : 'fullTitle');
const otherMode = mode === 'quick' ? 'full' : 'quick';
---
<Layout lang={lang} title={title} path={`test/${mode}`} active="test" footer={false}>
    <main class="quiz-page">
        <div class="quiz-intro">
            <h1>{title}</h1>
            <p>{t(lang, 'quizDek')}</p>
        </div>
        <div class="quiz-card" id="quiz" data-mode={mode} data-result={url(lang, 'result')}>
            <div class="quiz-head">
                <span class="label">{t(lang, 'site')} · v{tests.version}</span>
                <span class="quiz-count" data-count>1 / {n}</span>
            </div>
            <div class="bar"><div class="bar-fill" data-bar></div></div>
            <p class="statement" data-text></p>
            <div class="answers" data-answers></div>
            <div class="quiz-foot">
                <button type="button" class="ghost" data-back>{t(lang, 'back')}</button>
                <a class="ghost" href={url(lang, `test/${otherMode}`)}>{t(lang, otherMode === 'quick' ? 'quickTitle' : 'fullTitle')} →</a>
            </div>
        </div>
    </main>
    <script type="application/json" id="compass-data" set:html={JSON.stringify(data)} />
</Layout>

<script>
  import { score, encodeResult } from '../../../lib/compass.js';

  const D = JSON.parse(document.getElementById('compass-data').textContent);
  const root = document.getElementById('quiz');
  const mode = root.dataset.mode;
  const ids = D.tests[mode];
  const S = D.strings;
  const KEY = `ai-compass:${mode}:v${D.version}`;
  const store = {
    get() { try { return JSON.parse(sessionStorage.getItem(KEY)); } catch { return null; } },
    set(v) { try { sessionStorage.setItem(KEY, JSON.stringify(v)); } catch { /* private mode */ } },
    clear() { try { sessionStorage.removeItem(KEY); } catch { /* private mode */ } },
  };
  const saved = store.get();
  const answers = saved && saved.answers && saved.answers.length === ids.length ? saved.answers : new Array(ids.length).fill(null);
  let i = saved ? Math.min(saved.i ?? 0, ids.length - 1) : 0;
  const OPTIONS = [[2, 'a2'], [1, 'a1'], [0, 'a0'], [-1, 'am1'], [-2, 'am2']];

  function render() {
    root.querySelector('[data-count]').textContent = S.count.replace('{i}', i + 1).replace('{n}', ids.length);
    root.querySelector('[data-bar]').style.width = `${(i / ids.length) * 100}%`;
    root.querySelector('[data-text]').textContent = D.questions[ids[i]].text[D.lang];
    const box = root.querySelector('[data-answers]');
    box.innerHTML = '';
    OPTIONS.forEach(([v, k], n) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `answer ${k}` + (answers[i] === v ? ' picked' : '');
      const kbd = document.createElement('kbd');
      kbd.textContent = String(n + 1);
      b.append(S[k], kbd);
      b.addEventListener('click', () => pick(v));
      box.appendChild(b);
    });
    root.querySelector('[data-back]').style.visibility = i === 0 ? 'hidden' : 'visible';
  }
  function pick(v) {
    answers[i] = v;
    if (i < ids.length - 1) { i++; store.set({ answers, i }); render(); return; }
    store.clear();
    location.href = `${root.dataset.result}?${encodeResult(D.version, mode, score(D.questions, ids, answers))}`;
  }
  function back() { if (i > 0) { i--; store.set({ answers, i }); render(); } }
  root.querySelector('[data-back]').addEventListener('click', back);
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const v = { 1: 2, 2: 1, 3: 0, 4: -1, 5: -2 }[e.key];
    if (v !== undefined) pick(v);
    if (e.key === 'Backspace' || e.key === 'ArrowLeft') back();
  });
  render();
</script>
